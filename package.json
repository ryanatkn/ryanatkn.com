{
  "name": "ryanatkn.com",
  "version": "0.0.1",
  "description": "@ryanatkn's homepage and blog",
  "tagline": "all ways a wip",
  "glyph": "🪶",
  "logo": "favicon.png",
  "logo_alt": "a textured green nature circle with a void center",
  "license": "0BSD",
  "homepage": "https://www.ryanatkn.com/",
  "author": {
    "name": "Ryan Atkinson",
    "email": "mail@ryanatkn.com",
    "url": "https://www.ryanatkn.com/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ryanatkn/ryanatkn.com.git"
  },
  "bugs": "https://github.com/ryanatkn/ryanatkn.com/issues",
  "funding": "https://www.ryanatkn.com/funding",
  "scripts": {
    "start": "gro dev",
    "dev": "gro dev",
    "build": "gro build",
    "check": "gro check",
    "test": "gro test",
    "preview": "vite preview",
    "deploy": "gro deploy"
  },
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*",
    "#routes/*": "./src/routes/*"
  },
  "engines": {
    "node": ">=24.14"
  },
  "devDependencies": {
    "@fuzdev/blake3-wasm": "^0.2.0",
    "@fuzdev/fuz_blog": "^0.37.0",
    "@fuzdev/fuz_code": "^0.56.0",
    "@fuzdev/fuz_css": "^0.72.0",
    "@fuzdev/fuz_repos": "^0.89.0",
    "@fuzdev/fuz_schema": "^0.5.0",
    "@fuzdev/fuz_ui": "^0.221.0",
    "@fuzdev/fuz_util": "^0.79.0",
    "@fuzdev/gro": "^0.224.0",
    "@fuzdev/mdz": "^0.7.0",
    "@ryanatkn/eslint-config": "^0.13.1",
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/estree": "^1.0.8",
    "@types/node": "^24.10.1",
    "date-fns": "^4.1.0",
    "eslint": "^9.39.1",
    "eslint-plugin-svelte": "^3.13.1",
    "esm-env": "^1.2.2",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "svelte-docinfo": "^0.17.0",
    "svelte2tsx": "^0.7.55",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.0"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    "./package.json": "./package.json",
    "./*.js": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./*.ts": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  }
}
